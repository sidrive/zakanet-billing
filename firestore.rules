rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/authorized_users/$(userEmail()))
        && get(/databases/$(database)/documents/authorized_users/$(userEmail())).data.status == 'approved';
    }

    match /authorized_users/{email} {
      allow get: if isSignedIn() && userEmail() == email;
      allow create: if isSignedIn()
        && userEmail() == email
        && request.resource.data.email == email
        && request.resource.data.status == 'pending';
      allow update, delete, list: if false;
    }

    // ── Data billing & keuangan — hanya user yang sudah "approved" ──
    match /customers/{id}      { allow read, write: if isApproved(); }
    match /invoices/{id}       { allow read, write: if isApproved(); }
    match /payments/{id}       { allow read, write: if isApproved(); }
    match /products/{id}       { allow read, write: if isApproved(); }
    match /expenses/{id}       { allow read, write: if isApproved(); }
    match /revenues/{id}       { allow read, write: if isApproved(); }
    match /receivables/{id}    {
        allow read, write: if isApproved();
        match /receivable_payments/{paymentId} {
            allow read, write: if isApproved();
        }
    }
    match /categories/{id}     { allow read, write: if isApproved(); }
    match /promo_settings/{id} { allow read, write: if isApproved(); }
    match /promo_winners/{id}  { allow read, write: if isApproved(); }
  }
}
